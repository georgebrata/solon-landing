# Defence in depth for Hostico cPanel Apache (public_html).
# Forbids HTTP access to VCS, build tooling, and sources that must not be public.
# Does not rewrite or redirect existing HTML routes; DirectoryIndex still serves
# /blog/<slug>/, /studii-de-caz/, etc. .well-known stays allowed for ACME.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # BEGIN issue #33: canonical host redirects
  # Single canonical host: https://solon.agency (path + query preserved).
  # Skip ACME HTTP-01 so cPanel AutoSSL can renew over http://.
  RewriteRule ^\.well-known/acme-challenge/ - [L]

  # HTTP → HTTPS apex. Redirect only when BOTH %{HTTPS} is off and
  # X-Forwarded-Proto is not https, so SSL terminators / Hostico proxies
  # cannot loop. Query string is passed through (substitution has no ?).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://solon.agency%{REQUEST_URI} [L,R=301]

  # www → apex (HTTPS, or HTTP already forwarded as HTTPS)
  RewriteCond %{HTTP_HOST} ^www\.solon\.agency$ [NC]
  RewriteRule ^ https://solon.agency%{REQUEST_URI} [L,R=301]
  # END issue #33

  # Let's Encrypt / other well-known challenges
  RewriteRule ^\.well-known(?:/|$) - [L]

  # Dotfiles and dot-directories (.git, .github, .ftp-deploy-sync-state.json, ...)
  RewriteRule (^|/)\. - [F,L]

  # Tooling directories (not part of the runtime site)
  RewriteRule ^(?:tests|scripts|templates|docs|node_modules|skills)(?:/|$) - [F,L]
  RewriteRule ^blog/posts(?:/|$) - [F,L]

  # SHORTLINKS:START
  # Generated by scripts/build-shortlinks.js. Do not edit by hand.
  # Browsers (Accept contains text/html) rewrite to r/<path>/index.html.
  # Every other client gets the redirect below. NE keeps the raw query.
  RewriteCond %{HTTP:Accept} text/html
  RewriteRule ^api/?$ /r/api/index.html [L]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteRule ^api/?$ - [E=SLQ:%{QUERY_STRING}]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteCond %{ENV:SLQ} ^$
  RewriteRule ^api/?$ https://script.google.com/macros/s/AKfycbzJQOSxwXJGkSAmJnPeY2-cG5e2iCZ4cZr82cC8ft_Fxku1wfjKUHQGo09avC1eDyI3/exec [R=302,L,NE]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteCond %{ENV:SLQ} ^&?(.*)$
  RewriteRule ^api/?$ https://script.google.com/macros/s/AKfycbzJQOSxwXJGkSAmJnPeY2-cG5e2iCZ4cZr82cC8ft_Fxku1wfjKUHQGo09avC1eDyI3/exec?%1 [R=302,L,NE]
  RewriteCond %{HTTP:Accept} text/html
  RewriteRule ^bronze\/lunar/?$ /r/bronze/lunar/index.html [L]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteRule ^bronze\/lunar/?$ - [E=SLQ:%{QUERY_STRING}]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteCond %{QUERY_STRING} !(^|&)language(=|&|$)
  RewriteRule ^bronze\/lunar/?$ - [E=SLQ:%{ENV:SLQ}&language=ro]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteCond %{ENV:SLQ} ^$
  RewriteRule ^bronze\/lunar/?$ https://mpy.ro/99mzfyjht [R=302,L,NE]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteCond %{ENV:SLQ} ^&?(.*)$
  RewriteRule ^bronze\/lunar/?$ https://mpy.ro/99mzfyjht?%1 [R=302,L,NE]
  RewriteCond %{HTTP:Accept} text/html
  RewriteRule ^bronze\/anual/?$ /r/bronze/anual/index.html [L]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteRule ^bronze\/anual/?$ - [E=SLQ:%{QUERY_STRING}]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteCond %{QUERY_STRING} !(^|&)language(=|&|$)
  RewriteRule ^bronze\/anual/?$ - [E=SLQ:%{ENV:SLQ}&language=ro]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteCond %{ENV:SLQ} ^$
  RewriteRule ^bronze\/anual/?$ https://mpy.ro/99mzfykht [R=302,L,NE]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteCond %{ENV:SLQ} ^&?(.*)$
  RewriteRule ^bronze\/anual/?$ https://mpy.ro/99mzfykht?%1 [R=302,L,NE]
  RewriteCond %{HTTP:Accept} text/html
  RewriteRule ^silver\/lunar/?$ /r/silver/lunar/index.html [L]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteRule ^silver\/lunar/?$ - [E=SLQ:%{QUERY_STRING}]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteCond %{QUERY_STRING} !(^|&)language(=|&|$)
  RewriteRule ^silver\/lunar/?$ - [E=SLQ:%{ENV:SLQ}&language=ro]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteCond %{ENV:SLQ} ^$
  RewriteRule ^silver\/lunar/?$ https://mpy.ro/99mzg0rht [R=302,L,NE]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteCond %{ENV:SLQ} ^&?(.*)$
  RewriteRule ^silver\/lunar/?$ https://mpy.ro/99mzg0rht?%1 [R=302,L,NE]
  RewriteCond %{HTTP:Accept} text/html
  RewriteRule ^silver\/anual/?$ /r/silver/anual/index.html [L]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteRule ^silver\/anual/?$ - [E=SLQ:%{QUERY_STRING}]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteCond %{QUERY_STRING} !(^|&)language(=|&|$)
  RewriteRule ^silver\/anual/?$ - [E=SLQ:%{ENV:SLQ}&language=ro]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteCond %{ENV:SLQ} ^$
  RewriteRule ^silver\/anual/?$ https://mpy.ro/99mzg0sht [R=302,L,NE]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteCond %{ENV:SLQ} ^&?(.*)$
  RewriteRule ^silver\/anual/?$ https://mpy.ro/99mzg0sht?%1 [R=302,L,NE]
  RewriteCond %{HTTP:Accept} text/html
  RewriteRule ^gold\/lunar/?$ /r/gold/lunar/index.html [L]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteRule ^gold\/lunar/?$ - [E=SLQ:%{QUERY_STRING}]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteCond %{QUERY_STRING} !(^|&)language(=|&|$)
  RewriteRule ^gold\/lunar/?$ - [E=SLQ:%{ENV:SLQ}&language=ro]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteCond %{ENV:SLQ} ^$
  RewriteRule ^gold\/lunar/?$ https://mpy.ro/99mzg0tht [R=302,L,NE]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteCond %{ENV:SLQ} ^&?(.*)$
  RewriteRule ^gold\/lunar/?$ https://mpy.ro/99mzg0tht?%1 [R=302,L,NE]
  RewriteCond %{HTTP:Accept} text/html
  RewriteRule ^gold\/anual/?$ /r/gold/anual/index.html [L]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteRule ^gold\/anual/?$ - [E=SLQ:%{QUERY_STRING}]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteCond %{QUERY_STRING} !(^|&)language(=|&|$)
  RewriteRule ^gold\/anual/?$ - [E=SLQ:%{ENV:SLQ}&language=ro]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteCond %{ENV:SLQ} ^$
  RewriteRule ^gold\/anual/?$ https://mpy.ro/99mzg0uht [R=302,L,NE]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteCond %{ENV:SLQ} ^&?(.*)$
  RewriteRule ^gold\/anual/?$ https://mpy.ro/99mzg0uht?%1 [R=302,L,NE]
  RewriteCond %{HTTP:Accept} text/html
  RewriteRule ^platinum\/lunar/?$ /r/platinum/lunar/index.html [L]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteRule ^platinum\/lunar/?$ - [E=SLQ:%{QUERY_STRING}]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteCond %{QUERY_STRING} !(^|&)language(=|&|$)
  RewriteRule ^platinum\/lunar/?$ - [E=SLQ:%{ENV:SLQ}&language=ro]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteCond %{ENV:SLQ} ^$
  RewriteRule ^platinum\/lunar/?$ https://mpy.ro/99mzg0vht [R=302,L,NE]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteCond %{ENV:SLQ} ^&?(.*)$
  RewriteRule ^platinum\/lunar/?$ https://mpy.ro/99mzg0vht?%1 [R=302,L,NE]
  RewriteCond %{HTTP:Accept} text/html
  RewriteRule ^platinum\/anual/?$ /r/platinum/anual/index.html [L]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteRule ^platinum\/anual/?$ - [E=SLQ:%{QUERY_STRING}]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteCond %{QUERY_STRING} !(^|&)language(=|&|$)
  RewriteRule ^platinum\/anual/?$ - [E=SLQ:%{ENV:SLQ}&language=ro]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteCond %{ENV:SLQ} ^$
  RewriteRule ^platinum\/anual/?$ https://mpy.ro/99mzg0wht [R=302,L,NE]
  RewriteCond %{HTTP:Accept} !text/html
  RewriteCond %{ENV:SLQ} ^&?(.*)$
  RewriteRule ^platinum\/anual/?$ https://mpy.ro/99mzg0wht?%1 [R=302,L,NE]
  # SHORTLINKS:END
</IfModule>

<FilesMatch "\.(md|markdown|toml|jsonl|yml|yaml)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "^(package\.json|package-lock\.json|feature-flags\.json|LICENSE)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# BEGIN issue #29: security headers
# Block order: redirects (#33) above, deny (#35) above, this headers block,
# then caching (#30) and ErrorDocument (#32) if those PRs land later.
# Inventory and how to switch CSP Report-Only → enforcing: docs/security-headers.md
#
# HSTS has includeSubDomains (no preload). Verified 2026-10-06: both
# dosargpt.solon.agency and link.solon.agency present valid Let's Encrypt
# certs over HTTPS. Do not add preload until every subdomain is HTTPS and
# the domain is submitted to https://hstspreload.org/.
#
# CSP is Report-Only. Clickjacking is enforced via X-Frame-Options and a
# minimal `frame-ancestors 'self'` CSP (Report-Only cannot enforce
# frame-ancestors). To enforce later: copy the Report-Only value onto
# Content-Security-Policy (keep frame-ancestors), then delete Report-Only
# and the short frame-ancestors-only header.
#
# ServerSignature Off is omitted: it is a core directive, not a module.
# <IfModule> cannot prevent a 500 when AllowOverride disallows it on
# Hostico. Header unset Server below is best-effort; ask Hostico for
# ServerTokens Prod in httpd.conf.

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "frame-ancestors 'self'"

  # PLACEHOLDER CSP collector (RFC 2606 .invalid — browsers will not deliver
  # reports until George replaces this URL with a real endpoint such as
  # report-uri.com or a dedicated n8n webhook). Also swap the same URL in
  # report-uri / report-to below, and add that origin to connect-src.
  Header always set Report-To "{\"group\":\"csp-endpoint\",\"max_age\":10886400,\"endpoints\":[{\"url\":\"https://REPLACE_WITH_CSP_REPORT_COLLECTOR.invalid/\"}]}"
  Header always set Reporting-Endpoints "csp-endpoint=\"https://REPLACE_WITH_CSP_REPORT_COLLECTOR.invalid/\""

  # Temporary 'unsafe-inline' (script-src + style-src): inline gtag, Clarity,
  # Metricool, Brevo init, font stylesheet onload=, page <style> blocks, and
  # Bootstrap/vendor patterns. Nonces/hashes are a follow-up (out of scope).
  # Tracker hosts stay allowlisted so #26 consent-gated loads still work; CSP
  # is not the legal consent control.
  # Support chat disabled — re-enable per Trello jIwDAiCn: add
  # https://solon-agency.app.n8n.cloud to connect-src below.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net https://www.clarity.ms https://scripts.clarity.ms https://cdn.brevo.com https://sibautomation.com https://*.brevo.com https://tracker.metricool.com https://analytics.ahrefs.com https://cdn.counter.dev https://challenges.cloudflare.com https://mny.ro https://cdn.jsdelivr.net https://unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://challenges.cloudflare.com; img-src 'self' data: https://www.facebook.com https://*.facebook.com https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com https://www.google.com https://www.google.ro https://stats.g.doubleclick.net https://www.clarity.ms https://*.clarity.ms https://tracker.metricool.com https://mny.ro https://i.ibb.co https://challenges.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com https://*.googletagmanager.com https://analytics.google.com https://*.analytics.google.com https://stats.g.doubleclick.net https://www.google.com https://www.google.ro https://www.facebook.com https://*.facebook.com https://connect.facebook.net https://www.clarity.ms https://*.clarity.ms https://cdn.brevo.com https://sibautomation.com https://in-automate.brevo.com https://*.brevo.com https://tracker.metricool.com https://analytics.ahrefs.com https://cdn.counter.dev https://t.counter.dev https://script.google.com https://script.googleusercontent.com https://*.script.googleusercontent.com https://api64.ipify.org https://challenges.cloudflare.com https://mny.ro; frame-src 'self' https://calendar.google.com https://docs.google.com https://challenges.cloudflare.com; form-action 'self' https://formsubmit.co https://script.google.com https://script.googleusercontent.com; worker-src 'self' blob: https://www.clarity.ms https://scripts.clarity.ms https://challenges.cloudflare.com https://sibautomation.com; report-uri https://REPLACE_WITH_CSP_REPORT_COLLECTOR.invalid/; report-to csp-endpoint"

  # Shared hosts often ignore this; ServerTokens Prod needs httpd.conf.
  Header unset Server
  Header always unset Server
</IfModule>
# END issue #29

# BEGIN issue #30: caching
# Long-cache only under /assets/. HTML, /blog/posts.json, /feedback/, and
# /.well-known stay short or no-cache. CSS/JS are query-stamped (?v=<hash>)
# by scripts/stamp-asset-refs.js. Images/fonts/PDF are long-cached without
# query tokens: rename the file when the bytes change (do not overwrite).
# Block order: redirects (#33), deny (#35), headers (#29), caching (#30),
# ErrorDocument (#32). Do not reorder the deny or redirect blocks above.
AddDefaultCharset utf-8

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

<If "%{REQUEST_URI} =~ m#^/assets/#">
  <IfModule mod_expires.c>
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    ExpiresByType application/pdf "access plus 1 year"
  </IfModule>
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000" "expr=%{REQUEST_URI} =~ m#\.(css|js|mjs|png|jpe?g|gif|webp|svg|ico|avif|woff2?|ttf|eot|otf|pdf)$#i"
  </IfModule>
</If>

<IfModule mod_headers.c>
  <FilesMatch "\.(?i:html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # SHORTLINKS-LATE:START
  <If "%{REQUEST_URI} =~ m#^/r/#">
    <IfModule mod_expires.c>
      ExpiresActive Off
    </IfModule>
    Header unset Cache-Control
    Header always unset Cache-Control
    Header set Cache-Control "no-store"
    Header always merge Vary "Accept"
  </If>
  <If "%{REQUEST_URI} =~ m#^/(?:api|bronze\/lunar|bronze\/anual|silver\/lunar|silver\/anual|gold\/lunar|gold\/anual|platinum\/lunar|platinum\/anual)/?$#">
    <IfModule mod_expires.c>
      ExpiresActive Off
    </IfModule>
    Header unset Cache-Control
    Header always unset Cache-Control
    Header set Cache-Control "no-store" "expr=%{REQUEST_STATUS} < 300"
    Header always set Cache-Control "no-store" "expr=%{REQUEST_STATUS} >= 300"
    Header always merge Vary "Accept"
  </If>
  # SHORTLINKS-LATE:END

  <Files "posts.json">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>

  <FilesMatch "^(sitemap\.xml|robots\.txt|llms\.txt)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

<If "%{REQUEST_URI} =~ m#^/\.well-known/#">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, must-revalidate"
  </IfModule>
</If>
# END issue #30: caching

# BEGIN gzip fallback (mod_deflate)
# Hostico serves Brotli for many clients; gzip-only crawlers and Accept-Encoding:
# gzip must still get compressed CSS/JS/HTML/SVG. Does not disable server Brotli.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
  SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|avif|ico|woff2?|ttf|eot|otf|pdf|zip|gz|br)$ no-gzip dont-vary
</IfModule>
# END gzip fallback

# BEGIN issue #32: error documents
# Keep this block last: redirects (#33), deny (#35), headers (#29),
# caching (#30), then ErrorDocument (#32).
# Root-relative ErrorDocument paths preserve the original HTTP status
# (404 / 403 / 500). Absolute https:// URLs would 302 and return 200.
# 403 covers the deny rules above so forbidden paths get the branded page
# instead of the stock Apache address footer.
ErrorDocument 403 /403.html
ErrorDocument 404 /404.html
ErrorDocument 500 /500.html
ErrorDocument 502 /500.html
ErrorDocument 503 /500.html

<FilesMatch "^(403|404|500)\.html$">
  <IfModule mod_mime.c>
    AddDefaultCharset UTF-8
  </IfModule>
</FilesMatch>
# END issue #32
