{
  "name": "solon-landing",
  "private": true,
  "scripts": {
    "minify": "node scripts/minify-assets.js",
    "flags": "node scripts/apply-feature-flags.js",
    "flags:dry": "node scripts/apply-feature-flags.js --dry-run",
    "flags:status": "node scripts/apply-feature-flags.js --status",
    "test:flags": "node scripts/test-feature-flags.js",
    "test:forms": "node --test tests/forms.test.js tests/error-log.test.js tests/turnstile-gate.test.js",
    "test:consent": "node --test tests/consent.test.js tests/html-integrity.test.js",
    "test": "node --test tests/*.test.js && node scripts/test-feature-flags.js",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "test:chat": "node --test tests/support-chat.test.js"
  },
  "devDependencies": {
    "clean-css": "^5.3.3",
    "js-yaml": "^4.3.2",
    "marked": "^17.0.5",
    "terser": "^5.37.0"
  }
}
